#!/bin/sh
# Stage 0.1 design scaffold for Debian Live.
# Requires live-build and pinned Debian snapshot/source policy in Stage 1.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
ARCH="${RADAR_OS_ARCH:-}"
case "$ARCH" in
  amd64|arm64) ;;
  *) echo "RADAR_OS_ARCH must be explicitly set to amd64 or arm64" >&2; exit 2 ;;
esac
command -v lb >/dev/null 2>&1 || { echo "live-build (lb) is required" >&2; exit 2; }
mkdir -p config/package-lists
install -m 0644 "$ROOT/config/package-manifest.common.txt" config/package-lists/radar-common.list.chroot
install -m 0644 "$ROOT/config/package-manifest.$ARCH.txt" config/package-lists/radar-architecture.list.chroot

case "$ARCH" in
  amd64) SERIAL_CONSOLE="console=tty0 console=ttyS0,115200n8" ;;
  arm64) SERIAL_CONSOLE="console=tty0 console=ttyAMA0,115200n8" ;;
esac

set -- \
  --architectures "$ARCH" \
  --distribution trixie \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer false \
  --binary-images iso-hybrid \
  --bootappend-live "$SERIAL_CONSOLE systemd.show_status=1 systemd.unit=multi-user.target" \
  --apt-recommends false \
  --memtest none

if [ -n "${RADAR_OS_SNAPSHOT_TIMESTAMP:-}" ]; then
  case "$RADAR_OS_SNAPSHOT_TIMESTAMP" in
    ????????T??????Z) ;;
    *) echo "RADAR_OS_SNAPSHOT_TIMESTAMP must use YYYYMMDDTHHMMSSZ" >&2; exit 2 ;;
  esac
  SNAPSHOT="https://snapshot.debian.org/archive/debian/${RADAR_OS_SNAPSHOT_TIMESTAMP}/"
  SECURITY_SNAPSHOT="https://snapshot.debian.org/archive/debian-security/${RADAR_OS_SNAPSHOT_TIMESTAMP}/"
  set -- "$@" \
    --mirror-bootstrap "$SNAPSHOT" \
    --mirror-chroot "$SNAPSHOT" \
    --mirror-binary "$SNAPSHOT" \
    --mirror-chroot-security "$SECURITY_SNAPSHOT" \
    --mirror-binary-security "$SECURITY_SNAPSHOT"
fi

lb config "$@"

# Package selection, branding, service units, signing, and image metadata remain
# explicit Stage 1 work. No privileged RADAR service is enabled here.
