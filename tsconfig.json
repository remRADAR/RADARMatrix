{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/contracts/**/*.d.ts",
    "apps/mcp-server/src/auth/**/*.ts",
    "apps/mcp-server/src/runtime/github-readonly.ts"
  ]
}
