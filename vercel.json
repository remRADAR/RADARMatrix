{
  "version": 2,
  "builds": [
    { "src": "api/index.mjs", "use": "@vercel/node" },
    { "src": "apps/brand-studio/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "src": "^/$", "dest": "/apps/brand-studio/index.html" },
    { "src": "/(.*)", "dest": "/apps/brand-studio/$1" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
