{
  "name": "radarmatrix",
  "version": "0.9.0",
  "description": "RADARMatrix brand asset command center and MCP integration foundation",
  "type": "module",
  "main": "apps/mcp-server/src/mcp-gateway.ts",
  "scripts": {
    "test": "RADARMATRIX_RUNTIME_MODE=test node tests/test-runner.mjs",
    "test:gateway": "RADARMATRIX_RUNTIME_MODE=test node tests/v0.7-gateway.test.mjs",
    "test:contract": "node tests/v0.8-chatgpt-contract.test.mjs",
    "test:agents": "RADARMATRIX_RUNTIME_MODE=test node tests/agent-routing.test.mjs && RADARMATRIX_RUNTIME_MODE=test node tests/brand-gateway-routing.test.mjs",
    "brand:dev": "node apps/brand-studio/server.mjs",
    "brand:start": "node apps/brand-studio/server.mjs",
    "test:deployment": "RADARMATRIX_RUNTIME_MODE=production RADARMATRIX_NO_LISTEN=1 node tests/deployment-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build:matrix-console": "npm --prefix apps/matrix-console run build",
    "test:matrix-console": "node tests/matrix-console-smoke.mjs",
    "create:cloudflare-manifest": "node scripts/create-cloudflare-assets-manifest.mjs",
    "deploy:matrix-console:wrangler": "bash scripts/deploy-matrix-console-wrangler.sh",
    "test:security": "RADARMATRIX_RUNTIME_MODE=test node tests/gateway-integration-security.test.mjs",
    "check:authority-boundary": "node scripts/check-authority-boundary.mjs",
    "test:m2-3-1": "node tests/m2-3-1-boundary-contracts.test.mjs",
    "typecheck:matrix-console": "npm --prefix apps/matrix-console run typecheck"
  },
  "keywords": [
    "radarmatrix",
    "chatgpt",
    "mcp",
    "model-context-protocol"
  ],
  "author": "remRADAR",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=22.18"
  }
}
