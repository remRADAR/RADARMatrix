{
  "name": "radarmatrix",
  "version": "0.8.0",
  "description": "RADARMatrix brand asset command center and MCP integration foundation",
  "type": "module",
  "main": "apps/mcp-server/src/mcp-gateway.ts",
  "scripts": {
    "test": "node tests/test-runner.mjs && npm run test:matrix-ide",
    "test:gateway": "node tests/v0.7-gateway.test.mjs",
    "test:contract": "node tests/v0.8-chatgpt-contract.test.mjs",
    "test:agents": "node tests/agent-routing.test.mjs && node tests/brand-gateway-routing.test.mjs",
    "brand:dev": "node apps/brand-studio/server.mjs",
    "brand:start": "node apps/brand-studio/server.mjs",
    "test:deployment": "RADARMATRIX_RUNTIME_MODE=production RADARMATRIX_NO_LISTEN=1 node tests/deployment-smoke.mjs",
    "typecheck": "npm --prefix apps/matrix-console run typecheck",
    "build:matrix-console": "npm --prefix apps/matrix-console run build",
    "test:matrix-console": "node tests/matrix-console-smoke.mjs",
    "test:matrix-ide": "node tests/matrix-ide.test.mjs",
    "create:cloudflare-manifest": "node scripts/create-cloudflare-assets-manifest.mjs",
    "deploy:matrix-console:wrangler": "bash scripts/deploy-matrix-console-wrangler.sh"
  },
  "keywords": [
    "radarmatrix",
    "chatgpt",
    "mcp",
    "model-context-protocol"
  ],
  "author": "remRADAR",
  "license": "MIT",
  "devDependencies": {},
  "dependencies": {}
}
